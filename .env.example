# Where the Demucs stem service runs — the phone in Termux, a Google Colab GPU,
# a home server, or the bundled tools/audio-separator-server sidecar.
# The URL saved from the website's «ញែកភ្លេង · Demucs API» panel wins over these,
# because a phone tunnel gets a new address every time it is reopened.
AUDIO_SEPARATOR_URL=
AUDIO_SEPARATOR_API_KEY=
# Empty means "whatever the service defaults to".
AUDIO_SEPARATOR_MODEL=
# Empty means "try the usual /separate endpoints".
AUDIO_SEPARATOR_PATH=

# S3-compatible / Cloudflare R2 Storage Configuration (optional — a free host's
# disk is wiped on every restart, so without these uploads and results live only
# until the next deploy).
# Cloudflare R2 Endpoint: https://c838eceff526b328e8385736a138fb6b.r2.cloudflarestorage.com/061
S3_ENDPOINT=https://c838eceff526b328e8385736a138fb6b.r2.cloudflarestorage.com
S3_BUCKET=061
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Upload ceiling, in megabytes (video or audio).
MAX_VIDEO_SIZE_MB=500

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
